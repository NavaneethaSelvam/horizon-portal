{
  "name": "horizon-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "pretest": "prisma generate --schema prisma/schema.prisma",
    "test": "node --require ./scripts/test-node-preload.cjs --import tsx --test-concurrency=1 --test tests/phase2-rules.test.ts tests/phase2-api.test.ts tests/payroll.test.ts tests/finance.test.ts tests/task-board-rules.test.ts tests/workload-rules.test.ts tests/ai-insights.test.ts tests/assistant.test.ts tests/prisma-schemas.test.ts tests/security-hardening.test.ts",
    "generate:local": "prisma generate --schema prisma/schema.prisma",
    "generate:production": "prisma generate --schema prisma/postgresql/schema.prisma",
    "seed": "tsx prisma/seed.ts",
    "seed:production": "prisma generate --schema prisma/postgresql/schema.prisma && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "jose": "^6.2.13",
    "lucide-react": "0.468.0",
    "next": "^15.5.29",
    "next-themes": "0.4.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.2",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.15.30",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "next": {
      "sharp": "0.35.5"
    }
  }
}
