# Local development values; replace the placeholder before starting the application.
DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Production only: set these in the Vercel dashboard from the Neon connection details.
# DATABASE_URL should use Neon's pooled endpoint; DIRECT_URL should use its direct endpoint.
# DATABASE_URL="postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require"
# DIRECT_URL="postgresql://<role>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require"
# SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
